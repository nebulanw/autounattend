[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Microsoft\Edge\Recommended]
;; SECTION: Default search provider
;"DefaultSearchProviderEnabled"=dword:00000001
;"DefaultSearchProviderKeyword"="!d"
;"DefaultSearchProviderName"="DuckDuckGo"
;"DefaultSearchProviderSearchURL"="https://noai.duckduckgo.com/search?q={searchTerms}"

;; SECTION: Performance
;"EfficiencyMode"=dword:0000003

;; SECTION: Printing
"PrintHeaderFooter"=dword:00000000

;; SECTION: Sleeping tabs settings
"SleepingTabsEnabled"=dword:00000000

